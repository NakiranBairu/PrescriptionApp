@model IEnumerable<PrescriptionApp.Models.Prescription>

@{
    ViewData["Title"] = "Walgreens Prescriptions";
}




<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <img src="~/images/walgreens-seeklogo.png" alt="Walgreens" style="height: 60px;" class="mb-3">
            <h1 class="mt-2">Prescription Management</h1>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12">
            <a asp-controller="Prescription" asp-action="AddEdit" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add New Prescription
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <table class="table table-striped table-bordered">
                <thead class="thead-dark">
                    <tr>
                        <th>Medication Name</th>
                        <th>Fill Status</th>
                        <th>Cost</th>
                        <th>Request Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.MedicationName</td>
                            <td>
                                <span class="badge @GetStatusBadgeClass(item.FillStatus)">
                                    @item.FillStatus
                                </span>
                            </td>
                            <td>@item.Cost.ToString("C")</td>
                            <td>@item.RequestTime.ToString("MM/dd/yyyy HH:mm")</td>
                            <td>
                                <a asp-controller="Prescription" asp-action="AddEdit" 
                                   asp-route-id="@item.PrescriptionId" class="btn btn-sm btn-warning">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <a asp-controller="Prescription" asp-action="Delete" 
                                   asp-route-id="@item.PrescriptionId" class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash"></i> Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@functions {
    public string GetStatusBadgeClass(string status)
    {
        return status switch
        {
            "New" => "badge-primary",
            "Filled" => "badge-success",
            "Pending" => "badge-warning",
            _ => "badge-secondary"
        };
    }
}